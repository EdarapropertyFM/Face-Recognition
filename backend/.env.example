# Server
PORT=3000
# Comma-separated deployed frontend origins. Private LAN and localhost origins
# remain enabled for development and mobile enrollment testing.
FRONTEND_ORIGINS=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=stmc

# Local AI service (run from D:\stmc\ai_model)
AI_BASE_URL=http://127.0.0.1:8000
BIOMETRIC_STORAGE_DIR=D:\stmc\backend\storage

# Development only. Keep false in production and run database migrations.
DB_SYNCHRONIZE=true
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BIOMETRIC_ENCRYPTION_KEY=
# Separate key used to encrypt RTSP usernames/passwords at rest.
# Generate once with the same randomBytes command above; never expose it to the frontend.
CAMERA_CREDENTIALS_KEY=
# Signs short-lived browser playback links. Use another random value.
CAMERA_STREAM_SIGNING_KEY=
# Signs short-lived Server-Sent Events connections.
REALTIME_SIGNING_KEY=
JWT_SECRET=replace-with-at-least-32-random-characters

# Local demo data only. Never enable this in production unless intentionally provisioning a demo.
SEED_DEMO_DATA=true
SEED_DEFAULT_PASSWORD=replace-this-local-demo-password

# Used only by the local AI relay when it sends detection events to the API.
# Change this to a long random value before deployment.
STMC_AI_EVENT_TOKEN=stmc-ai-dev-token
