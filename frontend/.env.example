# Leave as /api to call the backend through the same origin (the Vite dev
# server proxies /api to port 3000). This is what makes the app work over
# ngrok or a LAN IP for phone testing.
# For a deployed environment, use the complete public API URL, for example:
# VITE_API_BASE_URL=https://stmc.example.com/api
VITE_API_BASE_URL=/api

# true = show presentation mock data on Alerts and Track & Trace instead of the API.
VITE_DEMO_DATA=false
