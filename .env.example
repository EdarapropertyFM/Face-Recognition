# STMC deployment settings. Copy to .env and fill in, then:
#
#   docker compose up -d --build
#
# Generate every secret below with:   ./scripts/generate-secrets.sh
# Never commit the filled-in .env: it holds the keys to resident biometric
# data. It is already in .gitignore.

# ---- Where people reach the system ----------------------------------
# The port the frontend is published on. 80 unless something else uses it.
HTTP_PORT=80

# The exact origin people type into the browser. CORS rejects anything not
# listed here, which shows up as every page loading but no data appearing.
# No trailing slash. Separate several with commas.
#   http://10.0.0.50        reached by IP
#   http://stmc.company.local
#   https://stmc.company.com   once a certificate is in place
FRONTEND_ORIGINS=http://localhost

# ---- Database --------------------------------------------------------
DB_USER=stmc
DB_NAME=stmc
# 12+ characters.
DB_PASSWORD=

# ---- First login -----------------------------------------------------
# Created once, only while the users table is empty. Change the password
# from inside the app afterwards.
ADMIN_USERNAME=admin
# 12+ characters. There is no default: the server refuses to start without it.
ADMIN_PASSWORD=

# ---- Secrets (generate, do not invent) -------------------------------
# 32+ characters. Signs the login tokens.
JWT_SECRET=
# 32+ characters. Shared between the backend and the AI so only the AI can
# report sightings. Both containers read the same value.
STMC_AI_EVENT_TOKEN=
# Base64 of exactly 32 bytes. Encrypts ID cards, lease pages, vehicle
# licences and face images on disk.
#
# WARNING: if this key is lost or changed, every document already stored
# becomes permanently unreadable. Back it up somewhere other than the server.
BIOMETRIC_ENCRYPTION_KEY=
# Base64 of exactly 32 bytes. Encrypts the DVR/camera passwords.
CAMERA_CREDENTIALS_KEY=
# 32+ characters each.
CAMERA_STREAM_SIGNING_KEY=
REALTIME_SIGNING_KEY=

# ---- Recognition -----------------------------------------------------
# Watch every enabled camera continuously and report sightings to Alerts and
# Track & Trace. Set false only to run the system as an enrolment desk with
# no live monitoring.
CAMERA_MONITORING=true

# ---- Demo data -------------------------------------------------------
# Leave false on a real deployment: the system starts empty, with no demo
# residents, cameras or units. true fills it with sample data for a trial.
SEED_DEMO_DATA=false
